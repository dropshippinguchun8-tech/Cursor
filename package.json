{
  "name": "cpamarket-uz",
  "version": "0.1.0",
  "private": true,
  "description": "CPAMaRKeT.Uz – Production-ready CPA platform monorepo powered by Turborepo, Next.js, NestJS, Prisma, and PostgreSQL.",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "e2e": "turbo run e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:migrate": "pnpm --filter apps-api db:migrate",
    "db:seed": "pnpm --filter apps-api db:seed"
  },
  "devDependencies": {
    "@turbo/gen": "^1.13.4",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.2.5",
    "turbo": "^1.13.4"
  }
}
